FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY langgraph_runtime/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt pytest pytest-asyncio

COPY langgraph_runtime /app/langgraph_runtime
COPY rag_service/runtime_protocol /app/runtime_protocol

CMD ["python", "-m", "langgraph_runtime.test_runner"]
