FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils tesseract-ocr libmagic-dev libgl1 libglib2.0-0 libgomp1 \
    libsndfile1 espeak-ng curl g++ \
    && rm -rf /var/lib/apt/lists/*

COPY rag_service/requirements-control-plane.txt requirements-control-plane.txt
COPY rag_service/requirements-dev.txt requirements-dev.txt
COPY langgraph_runtime/requirements.txt requirements-langgraph-service.txt
RUN pip install -r requirements-dev.txt
RUN pip install -r requirements-langgraph-service.txt
RUN python -m spacy download en_core_web_sm

COPY rag_service/alembic alembic
COPY rag_service/scripts scripts
COPY rag_service/app app
COPY rag_service/runtime_protocol runtime_protocol
COPY rag_service/tests tests
COPY rag_service/alembic.ini rag_service/main.py ./
COPY langgraph_runtime langgraph_runtime
COPY langgraph_runtime/tests /app/langgraph_runtime/tests

CMD ["python", "scripts/run_tests.py"]
